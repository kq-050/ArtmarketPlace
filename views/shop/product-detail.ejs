<%- include('../partials/header') %>

    <div class="container py-5">
        <div class="mb-4">
            <a href="/" class="text-dark text-decoration-none"><i class="fas fa-arrow-left me-2"></i> Back to
                Gallery</a>
        </div>

        <div class="row g-5">
            <!-- Left: Image (Col-md-7) -->
            <div class="col-md-7 d-flex flex-column align-items-center">
                <div class="mb-3 w-100 text-center">
                    <img src="<%= artwork.imagePath %>" class="img-fluid rounded shadow-sm" alt="<%= artwork.title %>"
                        style="max-height: 700px; width: auto; object-fit: contain;">
                </div>
                <!-- Thumbnails -->
                <div class="d-flex gap-3 justify-content-center">
                    <img src="<%= artwork.imagePath %>"
                        style="width: 80px; height: 80px; object-fit: cover; border: 2px solid var(--color-primary); border-radius: var(--radius-sm); cursor: pointer;">
                    <img src="<%= artwork.imagePath %>"
                        style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-sm); opacity: 0.6; cursor: pointer;">
                    <img src="<%= artwork.imagePath %>"
                        style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-sm); opacity: 0.6; cursor: pointer;">
                </div>
            </div>

            <!-- Right: Details (Col-md-5) -->
            <div class="col-md-5">
                <h1 class="font-serif fst-italic display-5 mb-2">
                    <%= artwork.title %>
                </h1>
                <h4 class="font-serif fst-italic mb-4 text-muted">
                    <%= artwork.artist.username %>
                </h4>

                <!-- Specs Box -->
                <div class="py-3 border-top border-bottom mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-layer-group me-3 text-muted" style="width: 20px;"></i>
                        <span class="fw-bold small me-2">Category:</span>
                        <span class="small">
                            <%= artwork.category %>
                        </span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-ruler-combined me-3 text-muted" style="width: 20px;"></i>
                        <span class="fw-bold small me-2">Size:</span>
                        <span class="small">
                            <%= artwork.dimensions %>
                        </span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-check-circle me-3 text-muted" style="width: 20px;"></i>
                        <span class="fw-bold small me-2">Availability:</span>
                        <span class="small">
                            <%= artwork.status==='Sold' ? 'Sold Out' : 'In Stock' %>
                        </span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-cube me-3 text-muted" style="width: 20px;"></i>
                        <span class="fw-bold small me-2">Product:</span>
                        <span class="small">Original Art</span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-palette me-3 text-muted" style="width: 20px;"></i>
                        <span class="fw-bold small me-2">Style:</span>
                        <span class="small">
                            <%= artwork.style %>
                        </span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-paint-brush me-3 text-muted" style="width: 20px;"></i>
                        <span class="fw-bold small me-2">Medium:</span>
                        <span class="small">
                            <%= artwork.medium %>
                        </span>
                    </div>
                </div>

                <h3 class="fw-bold mb-3 text-dark">$<%= artwork.price %>
                </h3>

                <p class="text-muted small mb-4" style="line-height: 1.8;">
                    <%= artwork.description %>
                </p>

                <% if(artwork.status !=='Sold' ) { %>
                    <div class="d-grid gap-2">
                        <form action="/cart/add" method="POST" class="d-grid">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="artworkId" value="<%= artwork._id %>">
                            <button type="submit" class="btn text-white fw-bold py-3"
                                style="background-color: var(--color-primary); border-radius: var(--radius-md); font-size: 1.1rem; box-shadow: var(--shadow-sm);">
                                <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                            </button>
                        </form>

                        <% if (isAuthenticated && currentUser.role==='Customer' ) { %>
                            <form action="/wishlist" method="POST" class="d-grid mt-2">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="artworkId" value="<%= artwork._id %>">
                                <button type="submit" class="btn btn-outline-dark fw-bold py-2"
                                    style="border-radius: var(--radius-md);">
                                    <i class="far fa-heart me-2"></i> Add to Wishlist
                                </button>
                            </form>
                            <% } %>
                    </div>
                    <% } else { %>
                        <div class="d-grid">
                            <button class="btn btn-secondary py-3 fw-bold" disabled>Sold Out</button>
                        </div>
                        <% } %>
            </div>
        </div>

        <!-- Recommendations -->
        <div class="mt-5 pt-5 border-top">
            <h3 class="font-serif fst-italic mb-4">You Might Also Like</h3>
            <div class="row g-4">
                <% if(artworks && artworks.length> 0) { %>
                    <% artworks.slice(0, 4).forEach(art=> { %>
                        <div class="col-md-3 col-6">
                            <a href="/artwork/<%= art._id %>" class="text-decoration-none text-dark">
                                <div class="card h-100 border-0 bg-transparent">
                                    <div class="position-relative">
                                        <img src="<%= art.imagePath %>" class="card-img-top rounded mb-2 shadow-sm"
                                            style="aspect-ratio: 1/1; object-fit: cover;">
                                        <% if(art.status==='Sold' ) { %>
                                            <span class="position-absolute top-0 end-0 badge bg-danger m-2">Sold</span>
                                            <% } %>
                                    </div>
                                    <div class="small fw-bold">
                                        <%= art.title %>
                                    </div>
                                    <div class="small text-muted">
                                        <%= art.artist.username %>
                                    </div>
                                    <div class="small fw-bold mt-1">$<%= art.price %>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
                            <% } %>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>