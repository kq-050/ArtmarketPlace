<%- include('../partials/header') %>

    <div class="container-fluid px-0 mb-5">
        <div class="container py-4"></div>

        <div class="container">
            <!-- Banner Title -->
            <h2 class="font-serif fst-italic mb-4" style="font-size: 2rem; color: #1a1a1a;">OUR BEST ARTS GALLERY</h2>

            <!-- Abstract Art Banner -->
            <div class="mb-5" style="width: 100%; height: 350px; overflow: hidden; border-radius: var(--radius-sm);">
                <img src="https://images.unsplash.com/photo-1541963463532-d68292c34b19?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80"
                    alt="Art Banner" style="width: 100%; height: 100%; object-fit: cover;">
            </div>

            <div class="row">
                <!-- Left Sidebar "JUST FOR YOU" -->
                <!-- Left Sidebar "JUST FOR YOU" -->
                <div class="col-lg-3 pe-lg-4 mb-5">
                    <div class="p-4 rounded" style="background-color: var(--color-bg-auth);"> <!-- Beige Background -->
                        <h3 class="font-serif fst-italic mb-4" style="font-size: 1.5rem;">JUST FOR YOU</h3>

                        <form action="/" method="GET" id="filterForm">
                            <!-- Category -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 small"><i class="fas fa-layer-group me-2"></i> Category</h6>
                                <div class="d-flex flex-column gap-2 small text-muted">
                                    <% ['Painting', 'Sculpture' , 'Digital' , 'Photography' ].forEach(cat=> { %>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="category"
                                                value="<%= cat %>" id="cat<%= cat %>" <%=selectedCategory===cat
                                                ? 'checked' : '' %> onchange="this.form.submit()">
                                            <label class="form-check-label" for="cat<%= cat %>">
                                                <%= cat %> Artwork
                                            </label>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>

                            <!-- Availability -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 small"><i class="fas fa-tags me-2"></i> Availability</h6>
                                <div class="form-check small text-muted">
                                    <input class="form-check-input" type="checkbox" name="availability" value="Stock"
                                        checked>
                                    <label class="form-check-label">In Stock</label>
                                </div>
                            </div>

                            <!-- Style -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 small"><i class="fas fa-palette me-2"></i> Style</h6>
                                <div class="d-flex flex-column gap-2 small text-muted">
                                    <% ['Abstract', 'Architecture' , 'Beach' ].forEach(s=> { %>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="style"
                                                value="<%= s %>" id="style<%= s %>">
                                            <label class="form-check-label" for="style<%= s %>">
                                                <%= s %>
                                            </label>
                                        </div>
                                        <% }) %>
                                </div>
                                <a href="#" class="small text-muted mt-2 d-inline-block">See more <i
                                        class="fas fa-chevron-down"></i></a>
                            </div>

                            <!-- Orientation -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 small"><i class="fas fa-compass me-2"></i> Orientation</h6>
                                <div class="d-flex flex-column gap-2 small text-muted">
                                    <% ['Landscape', 'Portrait' , 'Square' ].forEach(o=> { %>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="orientation"
                                                value="<%= o %>" id="orient<%= o %>">
                                            <label class="form-check-label" for="orient<%= o %>">
                                                <%= o %>
                                            </label>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>

                            <!-- Size -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 small"><i class="fas fa-ruler-combined me-2"></i> Size</h6>
                                <div class="d-flex flex-column gap-2 small text-muted">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="size" value="Small">
                                        <label class="form-check-label">Small (0-40cm)</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="size" value="Medium">
                                        <label class="form-check-label">Medium (41-99cm)</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="size" value="Large">
                                        <label class="form-check-label">Large (100cm+)</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Artist Search -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 small"><i class="fas fa-user me-2"></i> Artist</h6>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" name="search" placeholder="Search"
                                        value="<%= searchQuery %>">
                                    <button class="btn btn-outline-secondary" type="submit"><i
                                            class="fas fa-search"></i></button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Art Grid -->
                <div class="col-lg-9">
                    <div class="row g-4">
                        <% if(artworks.length> 0) { %>
                            <% artworks.forEach(art=> { %>
                                <div class="col-lg-4 col-sm-6 col-12">
                                    <div class="card h-100 border-0" style="background: transparent;">
                                        <div class="position-relative mb-2"
                                            style="border-radius: var(--radius-sm); overflow: hidden; aspect-ratio: 1/1;">
                                            <a href="/artwork/<%= art._id %>">
                                                <img src="<%= art.imagePath %>" class="w-100 h-100"
                                                    alt="<%= art.title %>" style="object-fit: cover;">
                                            </a>
                                            <div class="position-absolute top-0 start-0 p-2">
                                                <div class="bg-white rounded-circle d-flex align-items-center justify-content-center"
                                                    style="width: 30px; height: 30px; opacity: 0.8;">
                                                    <i class="far fa-clock" style="font-size: 0.8rem;"></i>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-body p-0">
                                            <div class="d-flex align-items-center mb-1">
                                                <div class="flex-grow-1">
                                                    <p class="mb-0 small text-muted"><i class="fas fa-globe me-1"></i>
                                                        The Pink Pasture Patrol</p>
                                                </div>
                                            </div>
                                            <h6 class="card-title text-truncate mb-0" style="font-size: 0.9rem;">
                                                <%= art.title %>
                                            </h6>
                                            <p class="card-text small text-muted mb-0">
                                                <%= art.artist.username %>
                                            </p>
                                            <p class="card-text fw-bold mt-1 text-dark">
                                                $<%= art.price %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="col-12 py-5 text-center">
                                            <p class="text-muted">No artworks found.</p>
                                        </div>
                                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-center mt-5 gap-3">
                        <% if(hasPrevPage) { %>
                            <a href="/?page=<%= currentPage - 1 %>" class="btn btn-sm btn-outline-dark border-0"><i
                                    class="fas fa-chevron-left"></i> Previous</a>
                            <% } %>
                                <span class="align-self-center small text-muted">Page <%= currentPage %> of <%=
                                            totalPages %></span>
                                <% if(hasNextPage) { %>
                                    <a href="/?page=<%= currentPage + 1 %>"
                                        class="btn btn-sm btn-outline-dark border-0">Next <i
                                            class="fas fa-chevron-right"></i></a>
                                    <% } %>
                    </div>
                </div>
            </div>

            <!-- ABOUT US Section -->
            <div class="row mt-5 pt-5 mb-5 align-items-center">
                <div class="col-12 mb-4">
                    <h3 class="font-serif fst-italic">ABOUT US</h3>
                </div>
                <div class="col-md-5">
                    <img src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80"
                        class="img-fluid rounded" alt="About">
                </div>
                <div class="col-md-7 ps-md-5">
                    <p class="text-muted small" style="line-height: 2;">
                        Founded in June 2024, ArtMarket Research is dedicated to fostering a vibrant art community. Our
                        mission is to connect artists with collectors who appreciate unique visions. We believe in the
                        power of art to transform spaces and inspire minds.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>