<%- include('../partials/header') %>

    <div class="container-fluid">
        <div class="row">
            <%- include('../partials/admin-sidebar') %>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4" style="min-height: 100vh;">
                    <div
                        class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4">
                        <h1 class="h2 fw-bold font-serif fst-italic">Edit Artwork</h1>
                        <a href="/admin/artworks" class="btn btn-outline-secondary px-4">
                            <i class="fas fa-arrow-left me-2"></i>Back to Artworks
                        </a>
                    </div>

                    <% if (typeof success_msg !=='undefined' && success_msg.length> 0) { %>
                        <div class="alert alert-success">
                            <%= success_msg %>
                        </div>
                        <% } %>
                            <% if (typeof error_msg !=='undefined' && error_msg.length> 0) { %>
                                <div class="alert alert-danger">
                                    <%= error_msg %>
                                </div>
                                <% } %>

                                    <div class="card shadow-sm border-0 p-4"
                                        style="border-radius: var(--radius-md); max-width: 900px;">

                                        <div class="mb-4 d-flex align-items-center bg-light p-3 rounded">
                                            <img src="<%= artwork.imagePath %>" class="rounded border me-4"
                                                style="width: 120px; height: 120px; object-fit: cover;">
                                            <div>
                                                <h4 class="mb-1">
                                                    <%= artwork.title %>
                                                </h4>
                                                <p class="text-muted mb-0">Artist: <strong>
                                                        <%= artwork.artist ? artwork.artist.username : 'Unknown' %>
                                                    </strong></p>
                                                <span class="badge bg-secondary mt-2">Uploaded: <%= new
                                                        Date(artwork.uploadedAt).toLocaleDateString() %></span>
                                            </div>
                                        </div>

                                        <form action="/admin/artworks/edit/<%= artwork._id %>" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                            <div class="row mb-3 gx-4">
                                                <div class="col-md-8">
                                                    <label class="form-label fw-bold small text-muted">Title</label>
                                                    <input type="text" name="title" class="form-control"
                                                        value="<%= artwork.title %>" required>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold small text-muted">Price ($)</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text">$</span>
                                                        <input type="number" name="price" class="form-control"
                                                            value="<%= artwork.price %>" min="0" required>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label fw-bold small text-muted">Description</label>
                                                <textarea name="description" class="form-control" rows="4"
                                                    required><%= artwork.description %></textarea>
                                            </div>

                                            <h5 class="font-serif fst-italic mb-3 pb-2 border-bottom">Classification &
                                                Physical Properties</h5>

                                            <div class="row mb-4 gx-4">
                                                <div class="col-md-4 mb-3 mb-md-0">
                                                    <label class="form-label fw-bold small text-muted">Category</label>
                                                    <select name="category" class="form-select">
                                                        <option value="Painting" <%=artwork.category==='Painting'
                                                            ? 'selected' : '' %>>Painting</option>
                                                        <option value="Sculpture" <%=artwork.category==='Sculpture'
                                                            ? 'selected' : '' %>>Sculpture</option>
                                                        <option value="Digital" <%=artwork.category==='Digital'
                                                            ? 'selected' : '' %>>Digital</option>
                                                        <option value="Photography" <%=artwork.category==='Photography'
                                                            ? 'selected' : '' %>>Photography</option>
                                                        <option value="Other" <%=artwork.category==='Other' ? 'selected'
                                                            : '' %>>Other</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4 mb-3 mb-md-0">
                                                    <label class="form-label fw-bold small text-muted">Medium</label>
                                                    <input type="text" name="medium" class="form-control"
                                                        value="<%= artwork.medium || '' %>"
                                                        placeholder="e.g. Oil on Canvas">
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold small text-muted">Style</label>
                                                    <input type="text" name="style" class="form-control"
                                                        value="<%= artwork.style || '' %>"
                                                        placeholder="e.g. Abstract, Modern">
                                                </div>
                                            </div>

                                            <div class="row mb-5 gx-4">
                                                <div class="col-md-4 mb-3 mb-md-0">
                                                    <label class="form-label fw-bold small text-muted">Size
                                                        Category</label>
                                                    <select name="sizeCategory" class="form-select">
                                                        <option value="Small" <%=artwork.sizeCategory==='Small'
                                                            ? 'selected' : '' %>>Small</option>
                                                        <option value="Medium" <%=artwork.sizeCategory==='Medium'
                                                            ? 'selected' : '' %>>Medium</option>
                                                        <option value="Large" <%=artwork.sizeCategory==='Large'
                                                            ? 'selected' : '' %>>Large</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4 mb-3 mb-md-0">
                                                    <label
                                                        class="form-label fw-bold small text-muted">Orientation</label>
                                                    <select name="orientation" class="form-select">
                                                        <option value="Portrait" <%=artwork.orientation==='Portrait'
                                                            ? 'selected' : '' %>>Portrait</option>
                                                        <option value="Landscape" <%=artwork.orientation==='Landscape'
                                                            ? 'selected' : '' %>>Landscape</option>
                                                        <option value="Square" <%=artwork.orientation==='Square'
                                                            ? 'selected' : '' %>>Square</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold small text-muted">Status</label>
                                                    <select name="status"
                                                        class="form-select fw-bold text-dark bg-light border-secondary">
                                                        <option value="Pending" <%=artwork.status==='Pending'
                                                            ? 'selected' : '' %>>Pending</option>
                                                        <option value="Approved" <%=artwork.status==='Approved'
                                                            ? 'selected' : '' %>>Approved</option>
                                                        <option value="Rejected" <%=artwork.status==='Rejected'
                                                            ? 'selected' : '' %>>Rejected</option>
                                                        <option value="Sold" <%=artwork.status==='Sold' ? 'selected'
                                                            : '' %>>Sold</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                                                <a href="/admin/artworks" class="btn btn-light px-4">Cancel</a>
                                                <button type="submit" class="btn text-white fw-bold px-4"
                                                    style="background-color: var(--color-primary);">
                                                    <i class="fas fa-save me-2"></i>Save Changes
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                </main>
        </div>
    </div>
    <%- include('../partials/footer') %>