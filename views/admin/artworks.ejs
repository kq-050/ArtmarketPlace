<%- include('../partials/header') %>

    <div class="container-fluid">
        <div class="row">
            <%- include('../partials/admin-sidebar') %>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4" style="min-height: 100vh;">
                    <div
                        class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4">
                        <h1 class="h2 fw-bold font-serif fst-italic">Manage Artworks</h1>
                        <span class="badge bg-info p-2">Total Artworks: <%= artworks.length %></span>
                    </div>

                    <% if (typeof success_msg !=='undefined' && success_msg.length> 0) { %>
                        <div class="alert alert-success">
                            <%= success_msg %>
                        </div>
                        <% } %>
                            <% if (typeof error_msg !=='undefined' && error_msg.length> 0) { %>
                                <div class="alert alert-danger">
                                    <%= error_msg %>
                                </div>
                                <% } %>

                                    <div class="card shadow-sm border-0" style="border-radius: var(--radius-md);">
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0"
                                                    style="min-width: 900px;">
                                                    <thead style="background-color: #fcfbf9;">
                                                        <tr>
                                                            <th class="border-0 px-4 py-3 fw-bold small text-muted">
                                                                Artwork</th>
                                                            <th class="border-0 px-4 py-3 fw-bold small text-muted">
                                                                Artist</th>
                                                            <th class="border-0 px-4 py-3 fw-bold small text-muted">
                                                                Category</th>
                                                            <th class="border-0 px-4 py-3 fw-bold small text-muted">Size
                                                            </th>
                                                            <th class="border-0 px-4 py-3 fw-bold small text-muted">
                                                                Style</th>
                                                            <th class="border-0 px-4 py-3 fw-bold small text-muted">
                                                                Status</th>
                                                            <th
                                                                class="border-0 px-4 py-3 fw-bold small text-muted text-center">
                                                                Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% artworks.forEach(artwork=> { %>
                                                            <tr>
                                                                <td class="px-4 py-3">
                                                                    <div class="d-flex align-items-center">
                                                                        <img src="<%= artwork.imagePath %>"
                                                                            alt="<%= artwork.title %>"
                                                                            class="rounded me-3 border"
                                                                            style="width: 40px; height: 40px; object-fit: cover;">
                                                                        <strong class="text-truncate"
                                                                            style="max-width: 150px; display: inline-block;"
                                                                            title="<%= artwork.title %>">
                                                                            <%= artwork.title %>
                                                                        </strong>
                                                                    </div>
                                                                </td>
                                                                <td class="px-4 py-3">
                                                                    <%= artwork.artist ? artwork.artist.username
                                                                        : 'Unknown' %>
                                                                </td>
                                                                <td class="px-4 py-3">
                                                                    <%= artwork.category %>
                                                                </td>
                                                                <td class="px-4 py-3">
                                                                    <%= artwork.sizeCategory %>
                                                                </td>
                                                                <td class="px-4 py-3">
                                                                    <%= artwork.style %>
                                                                </td>
                                                                <td class="px-4 py-3">
                                                                    <% if(artwork.status==='Approved' ) { %>
                                                                        <span
                                                                            class="badge rounded-pill bg-success fw-normal px-3 py-2">
                                                                            <%= artwork.status %>
                                                                        </span>
                                                                        <% } else if(artwork.status==='Pending' ) { %>
                                                                            <span
                                                                                class="badge rounded-pill bg-warning text-dark fw-normal px-3 py-2">
                                                                                <%= artwork.status %>
                                                                            </span>
                                                                            <% } else if(artwork.status==='Rejected' ) {
                                                                                %>
                                                                                <span
                                                                                    class="badge rounded-pill bg-danger fw-normal px-3 py-2">
                                                                                    <%= artwork.status %>
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span
                                                                                        class="badge rounded-pill bg-secondary fw-normal px-3 py-2">
                                                                                        <%= artwork.status %>
                                                                                    </span>
                                                                                    <% } %>
                                                                </td>
                                                                <td class="px-4 py-3">
                                                                    <div class="d-flex justify-content-center gap-2">
                                                                        <a href="/admin/artworks/edit/<%= artwork._id %>"
                                                                            class="btn btn-sm text-primary p-0 border-0 bg-transparent"
                                                                            title="Edit">
                                                                            <i class="fas fa-edit fs-5"></i>
                                                                        </a>
                                                                        <form
                                                                            action="/admin/artworks/delete/<%= artwork._id %>"
                                                                            method="POST" class="m-0"
                                                                            onsubmit="return confirm('Are you sure you want to delete this artwork? This action cannot be undone.');">
                                                                            <input type="hidden" name="_csrf"
                                                                                value="<%= csrfToken %>">
                                                                            <button type="submit"
                                                                                class="btn btn-sm text-danger p-0 border-0 bg-transparent ms-2"
                                                                                title="Delete">
                                                                                <i class="fas fa-trash fs-5"></i>
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% if(artworks.length===0) { %>
                                                                    <tr>
                                                                        <td colspan="7"
                                                                            class="text-center py-5 text-muted">
                                                                            <i class="fas fa-images fs-1 mb-3"></i>
                                                                            <p>No artworks found.</p>
                                                                        </td>
                                                                    </tr>
                                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                </main>
        </div>
    </div>
    <%- include('../partials/footer') %>