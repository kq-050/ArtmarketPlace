<%- include('../partials/header') %>

    <div class="d-flex align-items-center justify-content-center"
        style="min-height: 85vh; background-color: var(--color-bg-auth);">
        <div class="p-4" style="width: 100%; max-width: 450px;">

            <div class="text-center mb-4">
                <h2 class="font-serif fst-italic display-5 mb-3">REGISTER</h2>
            </div>

            <% if(error_msg && error_msg.length> 0) { %>
                <div class="alert alert-danger mb-3">
                    <%= error_msg %>
                </div>
                <% } %>
                    <% if(typeof errors !=='undefined' ) { %>
                        <% errors.forEach(function(error) { %>
                            <div class="alert alert-warning mb-2">
                                <%= error.msg %>
                            </div>
                            <% }); %>
                                <% } %>

                                    <form action="/auth/signup" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                        <div class="mb-3">
                                            <label class="form-label fw-bold small">Username</label>
                                            <input type="text" name="username" class="form-control"
                                                placeholder="johndoe"
                                                style="border-radius: var(--radius-md); padding: 0.75rem;">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold small">Email</label>
                                            <input type="email" name="email" class="form-control"
                                                placeholder="name@example.com"
                                                style="border-radius: var(--radius-md); padding: 0.75rem;">
                                        </div>



                                        <div class="mb-3">
                                            <label class="form-label fw-bold small">Password</label>
                                            <div class="input-group password-group">
                                                <input type="password" name="password"
                                                    class="form-control border-end-0 password-input"
                                                    placeholder="Enter your Password"
                                                    style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); padding: 0.75rem;">

                                                <span class="input-group-text bg-white border-start-0 toggle-password"
                                                    style="border-top-right-radius: var(--radius-md); border-bottom-right-radius: var(--radius-md); cursor: pointer;">
                                                    <i class="fas fa-eye text-muted"></i>
                                                </span>
                                            </div>
                                        </div>



                                        <!-- Role Selection hidden default to Customer, keeping simple for UI match unless functionality demands -->
                                        <div class="mb-3">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="role"
                                                    id="roleCustomer" value="Customer" checked onchange="toggleBio()">
                                                <label class="form-check-label" for="roleCustomer">Customer</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="role" id="roleArtist"
                                                    value="Artist" onchange="toggleBio()">
                                                <label class="form-check-label" for="roleArtist">Artist</label>
                                            </div>
                                        </div>

                                        <div class="mb-4 d-none" id="bioField">
                                            <label class="form-label fw-bold small">Bio</label>
                                            <textarea name="bio" class="form-control"
                                                placeholder="Tell us about yourself"></textarea>
                                        </div>

                                        <button type="submit" class="btn text-white w-100 fw-bold"
                                            style="background-color: var(--color-primary); border-radius: var(--radius-md); padding: 0.75rem;">
                                            Create Account
                                        </button>
                                    </form>

                                    <div class="text-center mt-3">
                                        <p class="small text-muted">Already have Account? <a href="/auth/login"
                                                class="text-dark fw-bold">Login</a></p>
                                    </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Select all password toggle spanning buttons
            const togglePasswordElements = document.querySelectorAll('.toggle-password');

            togglePasswordElements.forEach(function (toggleEl) {
                toggleEl.addEventListener('click', function () {
                    // Find the closest parent wrapper and then pinpoint the matching input
                    const inputGroup = this.closest('.password-group');
                    const passwordInput = inputGroup.querySelector('.password-input');
                    const icon = this.querySelector('i.fas');

                    if (!passwordInput || !icon) return;

                    // Toggle logic
                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash');
                    } else {
                        passwordInput.type = 'password';
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye');
                    }
                });
            });
        });

        function toggleBio() {
            const role = document.querySelector('input[name="role"]:checked').value;
            const bioField = document.getElementById('bioField');
            if (role === 'Artist') {
                bioField.classList.remove('d-none');
            } else {
                bioField.classList.add('d-none');
            }
        }
    </script>

    <%- include('../partials/footer') %>